---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout
  title={`${SITE.owner} — product, macro & astrophotography | ${SITE.name}`}
  description="Product photography, macro with focus stacking and astrophotography. Based in Częstochowa, Poland — working in Polish and English. Full English version coming soon."
  lang="en"
  noIndex
>
  <div class="flex min-h-[55dvh] flex-col items-center justify-center px-6 text-center">
    <h1 class="display text-5xl md:text-6xl">{SITE.owner}</h1>
    <p class="mt-3 text-moss">Product, macro & astrophotography — {SITE.name}</p>
    <p class="latin mt-3 text-lg text-moss">{SITE.motto}</p>
    <p class="mt-6 max-w-md text-sm text-dim">
      The full English version of this site is on its way. I work with clients in
      English too — feel free to write me at
      <a href={`mailto:${SITE.email}`} class="link-quiet">{SITE.email}</a>.
    </p>
    <a href="/" class="btn mt-10">Przejdź do wersji polskiej</a>
  </div>
</BaseLayout>
