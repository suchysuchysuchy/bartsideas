---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../config';

// Linie usług. Ceny ustalane per projekt — bez cennika-atrapy.
const services = [
  {
    name: 'Packshoty i fotografia produktowa',
    desc: 'Czyste kadry produktów na jednolitym tle oraz sceny aranżowane — do sklepu internetowego, katalogu, marketplace i social mediów. Spójna seria dla całej oferty, pliki przygotowane pod docelowe medium.',
    points: ['packshot na białym / czarnym tle', 'sceny lifestyle i aranżacje', 'makrodetal produktu', 'serie dla wielu SKU'],
  },
  {
    name: 'Makrofotografia i fotografia techniczna',
    desc: 'Zdjęcia w dużym powiększeniu z pełną głębią ostrości dzięki focus stackingowi (Helicon Focus Pro). Dokumentacja detalu: struktury, faktury, elementy precyzyjne, obiekty przyrodnicze.',
    points: ['focus stacking', 'kontrolowane, kierunkowe światło', 'dokumentacja detalu produkcyjnego', 'fotografia przyrodnicza'],
  },
  {
    name: 'Wnętrza i jedzenie',
    desc: 'Sesje dla lokali, pracowni i obiektów — naturalne światło, uporządkowana geometria kadru. Fotografia kulinarna dla menu, stron i profili społecznościowych.',
    points: ['wnętrza komercyjne i prywatne', 'fotografia kulinarna', 'serie na stronę i social media'],
  },
  {
    name: 'Astrofotografia i nocny krajobraz',
    desc: 'Dziesięć lat doświadczenia z nocnym niebem — projekty autorskie, kadry nocne na zamówienie i wydruki z archiwum. Nietypowe zlecenia nocne wyceniam indywidualnie.',
    points: ['nocny krajobraz na zamówienie', 'wydruki prac z archiwum', 'projekty specjalne'],
  },
  {
    name: 'Postprodukcja',
    desc: 'Także jako samodzielna usługa: selekcja materiału, wywołanie RAW, retusz, spójny kolor serii, składanie ekspozycji. Lightroom Classic, Photoshop, Helicon Focus, PixInsight, Topaz.',
    points: ['selekcja i wywołanie RAW', 'retusz i kolor serii', 'focus stacking / składanie ekspozycji'],
  },
];

// Cennik — pakiety startowe (ceny netto) i dopłaty za dodatkowe zdjęcia.
const pricing = [
  {
    name: 'Packshoty: pakiet startowy',
    price: '600 zł',
    unit: '10 gotowych zdjęć',
    scope:
      'Do 5 niewielkich, podobnych produktów, jedno uzgodnione tło i spójny sposób oświetlenia. Korekta koloru, podstawowy retusz, pliki do publikacji internetowej oraz w wysokiej rozdzielczości.',
  },
  {
    name: 'Makro i detale techniczne',
    price: '750 zł',
    unit: '5 gotowych zdjęć',
    scope:
      'Do 3 niewielkich obiektów, jedna uzgodniona koncepcja. Zbliżenia faktury, konstrukcji lub detalu, ze składaniem ostrości, gdy jest potrzebne.',
  },
  {
    name: 'Mieszkanie na sprzedaż lub wynajem',
    price: '650 zł',
    unit: '15 gotowych zdjęć',
    scope:
      'Jedno przygotowane mieszkanie do 70 m², do 90 minut fotografowania. Korekta geometrii, ekspozycji i koloru. Dojazd w granicach Częstochowy w cenie.',
  },
  {
    name: 'Podstawowa obróbka zdjęć',
    price: '250 zł',
    unit: '10 gotowych zdjęć',
    scope:
      'Materiał wybrany przez klienta, korekta ekspozycji i balansu bieli, kadrowanie, wyrównanie kolorystyki serii oraz eksport. Bez złożonego retuszu i fotomontażu.',
  },
  {
    name: 'Sesje aranżowane, kulinarne, wnętrza komercyjne',
    price: 'wycena indywidualna',
    unit: '',
    scope: 'Cena po ustaleniu liczby scen, ujęć, przygotowania planu i wykorzystania zdjęć.',
  },
  {
    name: 'Nocny krajobraz i projekty specjalne',
    price: 'wycena indywidualna',
    unit: '',
    scope: 'Lokalizacja, dojazd, zależność od pogody, czas realizacji i licencja ustalane osobno.',
  },
];

const extras = [
  { name: 'Kolejny prosty packshot w tym samym ustawieniu', price: '45 zł / zdjęcie' },
  { name: 'Kolejne zdjęcie makro o podobnej trudności', price: '150 zł / zdjęcie' },
  { name: 'Dodatkowe zdjęcie wnętrza z tej samej wizyty', price: '40 zł / zdjęcie' },
  { name: 'Kolejne zdjęcie w pakiecie podstawowej obróbki', price: '25 zł / zdjęcie' },
];

const steps = [
  {
    name: 'Brief',
    desc: 'Piszesz, co fotografujemy, gdzie zdjęcia będą użyte i na kiedy. Wystarczy kilka zdań — o resztę dopytam.',
  },
  {
    name: 'Wycena i termin',
    desc: 'Wracam z konkretną wyceną i harmonogramem w 1–2 dni robocze. Rozliczenie także przez Useme — z fakturą i umową, bez formalności po Twojej stronie.',
  },
  {
    name: 'Sesja',
    desc: 'W Częstochowie i okolicach pracuję na miejscu, na zlecenia dalej dojeżdżam (koszt dojazdu do ustalenia); produkty mogę też sfotografować u siebie po przesyłce. Zdjęcia robię pod ustalone zastosowanie.',
  },
  {
    name: 'Selekcja i dostawa',
    desc: 'Dostajesz wyselekcjonowane, wyretuszowane pliki w formatach pod web i druk, z ustaloną licencją.',
  },
];
---

<BaseLayout
  title={`Usługi — fotografia produktowa, makro, wnętrza | ${SITE.owner}`}
  description={`Fotografia na zamówienie: packshoty, sesje produktowe i lifestyle, makrofotografia z focus stackingiem, wnętrza i jedzenie, postprodukcja. ${SITE.location}. Rozliczenie przez Useme, praca po polsku i angielsku.`}
>
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <header class="max-w-2xl pb-14 md:pb-20">
      <p class="kicker mb-3">Usługi</p>
      <h1 class="display text-5xl md:text-6xl">Fotografia na zamówienie</h1>
      <p class="mt-5 text-moss">
        Zdjęcia robione z myślą o tym, do czego mają służyć — sprzedaży, dokumentacji,
        budowaniu marki. Kilka lat zarządzania w firmie produkcyjnej nauczyło mnie
        rozmawiać o fotografii językiem biznesu, nie tylko estetyki. Pracuję po polsku
        i angielsku, stacjonarnie w Częstochowie i okolicach lub zdalnie (produkty
        wysyłkowo, postprodukcja online).
      </p>
    </header>

    <!-- Linie usług. -->
    <section aria-labelledby="oferta" class="pb-20">
      <h2 id="oferta" class="kicker mb-8">Zakres</h2>
      <div class="space-y-10">
        {
          services.map((s, i) => (
            <article class="grid gap-4 border-t border-line pt-7 md:grid-cols-12 md:gap-8">
              <p class="tech !text-[0.65rem] md:col-span-1">{String(i + 1).padStart(2, '0')}</p>
              <div class="md:col-span-4">
                <h3 class="display text-2xl">{s.name}</h3>
              </div>
              <div class="md:col-span-7">
                <p class="text-sm leading-relaxed text-moss">{s.desc}</p>
                <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1.5">
                  {s.points.map((p) => (
                    <li class="tech !text-[0.68rem]">{p}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Cennik. -->
    <section aria-labelledby="cennik" class="pb-20">
      <h2 id="cennik" class="kicker mb-3">Cennik</h2>
      <p class="mb-10 max-w-2xl text-sm text-moss">
        Pakiety startowe poniżej to konkretny punkt wyjścia; większe i nietypowe projekty
        wyceniam indywidualnie. Podane ceny są cenami netto. Dojazd na zlecenie poza
        Częstochowę — możliwy, koszt do ustalenia.
      </p>

      <div class="space-y-8">
        {
          pricing.map((p) => (
            <article class="grid gap-3 border-t border-line pt-6 md:grid-cols-12 md:gap-8">
              <div class="md:col-span-4">
                <h3 class="display text-xl">{p.name}</h3>
              </div>
              <div class="md:col-span-3">
                <p class="tech !text-[0.8rem] !text-bone">{p.price}</p>
                {p.unit && <p class="tech mt-1 !text-[0.68rem]">{p.unit}</p>}
              </div>
              <p class="text-sm leading-relaxed text-moss md:col-span-5">{p.scope}</p>
            </article>
          ))
        }
      </div>

      <h3 class="kicker mt-14 mb-6">Dodatkowe zdjęcia (dopłaty do pakietów)</h3>
      <ul class="max-w-2xl">
        {
          extras.map((e) => (
            <li class="flex items-baseline justify-between gap-6 border-t border-line py-3">
              <span class="text-sm text-moss">{e.name}</span>
              <span class="tech whitespace-nowrap !text-[0.75rem] !text-bone">{e.price}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Przebieg współpracy. -->
    <section aria-labelledby="wspolpraca" class="pb-20">
      <h2 id="wspolpraca" class="kicker mb-8">Jak wygląda współpraca</h2>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((st, i) => (
            <article class="border-t border-line pt-5">
              <p class="tech mb-2 !text-[0.65rem]">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="display text-xl">{st.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-moss">{st.desc}</p>
            </article>
          ))
        }
      </div>
      <div class="mt-10 flex flex-wrap items-center gap-5">
        <a href={SITE.useme} rel="noopener" target="_blank" class="btn">Mój profil na Useme ↗</a>
        <p class="tech !text-[0.68rem]">bezpieczne rozliczenie · faktura · umowa</p>
      </div>
    </section>

    <!-- Formularz zapytania. -->
    <section id="zapytanie" aria-labelledby="zapytanie-title" class="max-w-2xl scroll-mt-28">
      <h2 id="zapytanie-title" class="display mb-3 text-3xl">Zapytanie o wycenę</h2>
      <p class="mb-8 text-sm text-moss">
        Napisz, co fotografujemy (rodzaj sesji, liczba produktów lub ujęć, terminy,
        gdzie zdjęcia będą używane) — wrócę z konkretną wyceną w 1–2 dni robocze.
      </p>
      <ContactForm subject="Zapytanie o wycenę — fotografia" id="form-uslugi" />
    </section>
  </div>
</BaseLayout>
