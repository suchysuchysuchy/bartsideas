---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE, socials } from '../config';
---

<BaseLayout
  title={`Kontakt | ${SITE.owner}`}
  description={`Zapytania o sesje produktowe, makrofotografię, wnętrza i postprodukcję. ${SITE.owner}, ${SITE.location}. Współpraca także przez Useme, po polsku i angielsku.`}
>
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <header class="max-w-2xl pb-12">
      <p class="kicker mb-3">Kontakt</p>
      <h1 class="display text-5xl md:text-6xl">Napisz do mnie</h1>
      <p class="mt-5 text-moss">
        Sesje produktowe, makro, wnętrza, postprodukcja, współprace — odpowiadam zwykle
        w 1–2 dni robocze, po polsku i angielsku.
      </p>
    </header>

    <div class="grid gap-14 lg:grid-cols-2">
      <ContactForm />

      <aside class="space-y-8" aria-label="Dane kontaktowe">
        <div>
          <h2 class="kicker mb-2">E-mail</h2>
          <a href={`mailto:${SITE.email}`} class="link-quiet text-lg">{SITE.email}</a>
        </div>

        <div class="border border-line bg-night-raised p-6">
          <h2 class="kicker mb-2">Zlecenie przez Useme</h2>
          <p class="text-sm text-moss">
            Wolisz formalną ścieżkę? Zlecenie możemy rozliczyć przez Useme —
            z umową i fakturą, bez formalności po Twojej stronie.
          </p>
          <a href={SITE.useme} rel="me noopener" target="_blank" class="btn mt-5">
            Mój profil na Useme ↗
          </a>
        </div>

        {
          socials.length > 0 && (
            <div>
              <h2 class="kicker mb-2">W sieci</h2>
              <ul class="space-y-1 text-sm">
                {socials.map((s) => (
                  <li>
                    <a class="link-quiet" href={s.href} rel="me noopener" target="_blank">
                      {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div>
          <h2 class="kicker mb-2">Pracownia</h2>
          <p class="text-sm text-moss">{SITE.location}</p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
