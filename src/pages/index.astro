---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import { SITE } from '../config';

const photos = await getCollection('photos');
const hero = photos.find((p) => p.data.hero) ?? photos[0];
// Hero nie powtarza się niżej; kadry głębokiego nieba pokazujemy
// w kwadratowym cropie (obiekt w centrum), pełny kadr — w portfolio.
const featured = photos
  .filter((p) => p.data.featured && !p.data.hero)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

// Obszary pracy — opisane tekstem, bez atrap zdjęć. Kadry komercyjne
// dojdą do portfolio, gdy będą wybrane i zatwierdzone.
const fields = [
  {
    title: 'Fotografia produktowa',
    desc: 'Packshoty, sceny lifestyle i makrodetal — zdjęcia, które mają sprzedawać: do sklepu internetowego, katalogu i social mediów.',
  },
  {
    title: 'Makro i fotografia techniczna',
    desc: 'Focus stacking, pełna kontrola światła i ostrości. Dokumentacja małych obiektów — od przyrody po detal produkcyjny.',
  },
  {
    title: 'Astrofotografia i nocny krajobraz',
    desc: 'Dziesięć lat pracy z nocnym niebem — wielogodzinne ekspozycje, projekty autorskie i warsztat, który widać w każdym kadrze.',
  },
  {
    title: 'Wnętrza, jedzenie, przyroda',
    desc: 'Spójne serie zdjęć dla lokali, pracowni i marek. Od sesji po gotowe, wyselekcjonowane pliki.',
  },
];
---

<BaseLayout
  title={`${SITE.owner} — ${SITE.tagline} | ${SITE.name}`}
  description={`${SITE.owner} (${SITE.name}) — ${SITE.tagline}. Packshoty, sesje produktowe, makro z focus stackingiem i astrofotografia. ${SITE.location}. Współpraca przez Useme, po polsku i angielsku.`}
  ogImage={hero.data.image}
  padTop={false}
>
  <!-- Hero: jeden kadr na pełen ekran, wyłaniający się z czerni. -->
  <section class="relative h-[100dvh]">
    <div class="reveal-hero absolute inset-0">
      <!-- Na pionowym ekranie object-cover renderuje obraz szerzej niż 100vw
           (proporcje kadru ~1,3 × wysokość widoku). min() ogranicza telefony
           do wariantu ~1600 px — na ciemnym kadrze różnica jest niewidoczna,
           a plik jest o połowę lżejszy (budżet LCP na 4G). -->
      <PhotoFrame
        image={hero.data.image}
        alt={hero.data.alt}
        sizes="(orientation: portrait) min(130vh, 900px), 100vw"
        loading="eager"
        fetchpriority="high"
        reveal={false}
        aspect="auto"
        class="h-full w-full"
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-night/60 via-night/20 to-night"></div>

    <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center">
      <p class="kicker mb-6">{SITE.name} · {SITE.location}</p>
      <h1 class="display text-5xl sm:text-6xl md:text-7xl">{SITE.owner}</h1>
      <p class="mt-4 max-w-xl text-lg text-bone sm:text-xl">
        Fotografia produktowa, makro i&nbsp;astrofotografia
      </p>
      <p class="latin mt-3 text-base text-moss sm:text-lg">
        {SITE.motto} — {SITE.mottoTranslation}
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <a href="/portfolio" class="btn btn-solid">Zobacz portfolio</a>
        <a href="/kontakt?temat=Zapytanie%20o%20sesję" class="btn">Zapytaj o sesję</a>
      </div>
    </div>

    <a
      href="#zakres"
      class="absolute bottom-8 left-1/2 flex h-11 w-11 -translate-x-1/2 items-center justify-center text-dim transition-colors hover:text-bone"
      aria-label="Przewiń w dół"
    >
      <svg width="12" height="28" viewBox="0 0 12 28" fill="none" aria-hidden="true">
        <path d="M6 0v26m0 0l5-5M6 26l-5-5" stroke="currentColor" stroke-width="1"></path>
      </svg>
    </a>
  </section>

  <!-- Czym się zajmuję. -->
  <section id="zakres" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-20 md:px-8 md:py-28">
    <p class="kicker mb-2">Zakres pracy</p>
    <h2 class="display mb-4 text-4xl md:text-5xl">Co mogę dla Ciebie sfotografować</h2>
    <p class="mb-12 max-w-2xl text-moss">
      Od packshotu po głębokie niebo — wspólnym mianownikiem jest kontrola światła,
      detal i pełna postprodukcja: selekcja, wywołanie RAW, retusz i spójny kolor
      całych serii.
    </p>
    <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
      {
        fields.map((f, i) => (
          <article class="border-t border-line pt-6">
            <p class="tech mb-3 !text-[0.65rem]">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="display text-2xl">{f.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-moss">{f.desc}</p>
          </article>
        ))
      }
    </div>
    <div class="mt-12">
      <a href="/uslugi" class="btn">Oferta i przebieg współpracy</a>
    </div>
  </section>

  <!-- Wybrane prace. -->
  <section class="mx-auto max-w-6xl px-5 pb-4 md:px-8">
    <p class="kicker mb-2">Wybrane prace</p>
    <h2 class="display mb-10 text-4xl md:text-5xl">Z autorskiego archiwum</h2>

    <div class="grid gap-6 sm:grid-cols-3">
      {
        featured.map((p) => (
          <a href="/portfolio" class="group block">
            <PhotoFrame
              image={p.data.image}
              alt={p.data.alt}
              aspect="1 / 1"
              sizes="(min-width: 640px) 33vw, 100vw"
            />
            <span class="mt-3 block">
              <span class="block text-sm text-bone transition-colors group-hover:text-white">
                {p.data.title}
              </span>
              {p.data.species && <span class="latin block text-sm text-moss">{p.data.species}</span>}
            </span>
          </a>
        ))
      }
    </div>

    <div class="mt-10">
      <a href="/portfolio" class="btn">Całe portfolio</a>
    </div>
  </section>

  <!-- Pas o autorze + wejście do współpracy. -->
  <section class="mx-auto max-w-3xl px-5 py-24 text-center md:px-8 md:py-32">
    <p class="latin text-2xl leading-relaxed text-bone md:text-3xl">„{SITE.motto}”</p>
    <p class="mt-6 text-moss">
      Fotografuję od kilkunastu lat, od dziesięciu pracuję z nocnym niebem. Zdjęcia robię
      z myślą o ich zastosowaniu — kilka lat zarządzania w firmie produkcyjnej nauczyło
      mnie patrzeć na fotografię także od strony sprzedaży. Pracuję po polsku i angielsku.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/o-mnie" class="btn">Poznaj mnie</a>
      <a href={SITE.useme} rel="noopener" target="_blank" class="btn">Profil na Useme ↗</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Wejście hero z czerni — animacja jasności zamiast opacity,
     żeby nie opóźniać LCP; wyłączana przy prefers-reduced-motion. */
  .reveal-hero {
    animation: hero-reveal 1.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes hero-reveal {
    from {
      filter: brightness(0.15);
    }
    to {
      filter: brightness(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-hero {
      animation: none;
    }
  }
</style>
