---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoCard from '../components/PhotoCard.astro';
import Lightbox from '../components/Lightbox.astro';
import { SITE } from '../config';

const photos = (await getCollection('photos'))
  .filter((p) => p.data.category === 'astro')
  .sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  photos.map(async (p) => ({ photo: p, Content: (await render(p)).Content })),
);

// Układ edytorski: poziomy kadr otwiera sekcję na pełną szerokość,
// pionowe (o zbliżonych proporcjach) idą w równym rzędzie.
const lead = rendered.find(({ photo }) => photo.data.image.width > photo.data.image.height);
const rest = rendered.filter((r) => r !== lead);

const firstImage = photos[0]?.data.image;

// schema.org — każde zdjęcie jako ImageObject z adresem pliku (contentUrl).
const imageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: await Promise.all(
    photos.map(async (p, i) => {
      const img = await getImage({
        src: p.data.image,
        width: Math.min(p.data.image.width, 2048),
        format: 'webp',
      });
      return {
        '@type': 'ImageObject',
        position: i + 1,
        name: p.data.title,
        description: p.data.alt,
        contentUrl: new URL(img.src, Astro.site).toString(),
        creator: { '@type': 'Person', name: SITE.owner },
        copyrightNotice: `© ${SITE.owner}`,
      };
    }),
  ),
};
---

<BaseLayout
  title={`Portfolio — astrofotografia | ${SITE.owner}`}
  description={`Autorska astrofotografia Bartłomieja Suchanka — mgławice i galaktyki fotografowane spod polskiego nieba. Portfolio ${SITE.name}.`}
  ogImage={firstImage}
  schema={imageSchema}
>
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <header class="max-w-2xl pb-14 md:pb-20">
      <p class="kicker mb-3">Portfolio</p>
      <h1 class="display text-5xl md:text-6xl">Prace autorskie</h1>
      <p class="mt-5 text-moss">
        Ta część portfolio pokazuje projekty własne — kadry, nad którymi mam pełną
        kontrolę od planowania po postprodukcję. To one najlepiej mówią o warsztacie,
        który wnoszę do pracy komercyjnej. Kliknij kadr, aby obejrzeć go w pełnym rozmiarze.
      </p>
    </header>

    <!-- Astro. -->
    <section id="astro" class="scroll-mt-28 pb-20 md:pb-24" aria-labelledby="astro-title">
      <div class="mb-10 border-t border-line pt-8">
        <p class="kicker mb-2">Portfolio · 01</p>
        <h2 id="astro-title" class="display text-4xl">Astrofotografia</h2>
        <p class="mt-3 max-w-xl text-sm text-moss">
          Obiekty głębokiego nieba fotografowane przez wiele godzin ekspozycji —
          zbieranie, kalibracja i składanie setek klatek, potem wywołanie koloru
          w PixInsight. Dziesięć lat praktyki z nocnym niebem.
        </p>
      </div>

      {
        lead && (
          <article class="mb-16">
            <PhotoCard photo={lead.photo} sizes="(min-width: 1152px) 1104px, 100vw" />
            <div class="prose-revelare -mt-4 max-w-xl text-sm leading-relaxed text-moss">
              <lead.Content />
            </div>
          </article>
        )
      }

      <div class="grid gap-x-8 gap-y-14 sm:grid-cols-3">
        {
          rest.map(({ photo, Content }) => (
            <article>
              <PhotoCard photo={photo} sizes="(min-width: 640px) 33vw, 100vw" />
              <div class="prose-revelare -mt-4 text-sm leading-relaxed text-moss">
                <Content />
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Zapowiedź sekcji komercyjnych — bez atrap. -->
    <section class="mb-8 border border-line bg-night-raised px-8 py-12 md:px-12" aria-labelledby="wkrotce">
      <p class="kicker mb-2">Portfolio · 02</p>
      <h2 id="wkrotce" class="display text-3xl md:text-4xl">Makro i fotografia produktowa</h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-moss">
        Wybór prac makro i realizacji produktowych przygotowuję do publikacji.
        Bieżące kadry pokazuję na Instagramie — a jeśli chcesz zobaczyć realizacje
        dopasowane do Twojego projektu, napisz: podeślę portfolio bezpośrednio.
      </p>
      <div class="mt-7 flex flex-wrap gap-4">
        <a href={SITE.instagram} rel="me noopener" target="_blank" class="btn">Instagram ↗</a>
        <a href="/kontakt?temat=Portfolio%20—%20poproszę%20o%20realizacje" class="btn">
          Poproś o realizacje
        </a>
      </div>
    </section>
  </div>

  <Lightbox />
</BaseLayout>
